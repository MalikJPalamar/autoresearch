# Supabase credentials — get from Project Settings > API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# REQUIRED for writes: RLS is enabled on all tables and allows SELECT only.
# The publishable key can read; only the secret key can insert/update.
SUPABASE_SECRET_KEY=sb_secret_your-key-here
